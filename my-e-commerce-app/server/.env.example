# =============================================================================
# ID Beddings and More - backend environment template
# =============================================================================
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# Values in this template are local-development defaults, not production
# secrets.
# =============================================================================

# Local PostgreSQL started by `docker compose up -d` in this folder.
DATABASE_URL="postgresql://idb:idb_dev_password@localhost:5432/idb?schema=public"

# Use a long random string in every environment (e.g. `openssl rand -hex 32`).
JWT_SECRET="replace-with-a-long-random-string"

PORT=5000
CLIENT_ORIGIN="http://localhost:3000"

# Seed an administrator on `npm run seed`. Leave blank to skip.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Store administrator"

# Paystack (Phase 6). Test keys only until the merchant account is verified.
# Never put these in the React app or commit them.
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""

# Webhook signing secret from the Paystack dashboard (starts with `whsec_`).
# When set, the timestamped Paystack-Signature header is verified. Leave blank
# to fall back to the legacy x-paystack-signature check.
PAYSTACK_WEBHOOK_SECRET=""

# Where Paystack sends the customer after checkout. The page asks this server to
# verify the transaction; the redirect itself is never treated as payment.
PAYMENT_CALLBACK_URL="http://localhost:3000/payment/callback"

# Optional override (default https://api.paystack.co). Useful for an approved
# mock provider during local testing.
# PAYSTACK_BASE_URL="https://api.paystack.co"
