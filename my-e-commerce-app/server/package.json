{
  "name": "id-beddings-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend API for ID Beddings and More (prd/agent.md Phase 5)",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test tests/",
