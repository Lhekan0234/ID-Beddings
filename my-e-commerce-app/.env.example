# =============================================================================
# ID Beddings and More — Environment Variable Template
# =============================================================================
# Copy this file to `.env` (frontend) and fill in real values locally.
# NEVER commit the real `.env` file — it is git-ignored (see .gitignore).
# This file contains PLACEHOLDERS ONLY. No real secrets are stored here.
# Values marked [PENDING] must be supplied by the business owner.
# =============================================================================

# -----------------------------------------------------------------------------
# Frontend (Create React App) — variables must be prefixed with REACT_APP_
# to be exposed to the React build.
# -----------------------------------------------------------------------------

# Base URL of the backend API. Used from Phase 5 onward when the Express API
# exists. Safe default for local development:
REACT_APP_API_URL=http://localhost:5000

# -----------------------------------------------------------------------------
# Backend (Express API) — created in Phase 5. Documented here now so the
# owner can prepare credentials. Leave blank until the backend exists.
# These are read by the SERVER only and are never exposed to the browser.
# -----------------------------------------------------------------------------

# Server port
PORT=5000

# PostgreSQL connection string used by Prisma. [PENDING] owner provides after
# the database is provisioned (e.g. Neon / Supabase). Format:
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=

# Secret used to sign login sessions (httpOnly JWT cookies). [PENDING]
# Generate a long random value; keep private.
JWT_SECRET=

# ---- Payments: Paystack (kept in TEST mode until the merchant account is
# configured and verified by the owner — see prd/agent.md section 9). [PENDING]
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# ---- Image storage: Cloudinary. [PENDING] owner provides from their
# Cloudinary dashboard (product images — see prd/agent.md section 5).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
